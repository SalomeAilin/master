<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.local.network-remote-access</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/network-remote-access-pf.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/network-remote-access.err</string>
	<key>StandardOutPath</key>
	<string>/var/log/network-remote-access.out</string>
	<key>StartInterval</key>
	<integer>60</integer>
</dict>
</plist>
